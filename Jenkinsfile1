pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        SONAR_PROJECT_KEY = 'maven-web-application'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Static Code Analysis') {
            steps {
                withSonarQubeEnv('SonarQubeServer') {
                    sh 'mvn sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.token=$SONAR_AUTH_TOKEN'
                }
            }
        }

        stage('Deployment Automation') {
            steps {
                sshagent(['ansible-ssh-key-credential']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@172.31.8.31 \
                        "ansible-playbook -i /home/ubuntu/ansible/hosts /home/ubuntu/ansible/deploy.yml"
                    '''
                }
            }
        }
    }
}
